{
  "name": "coder",
  "version": "0.1.0",
  "description": "CODER — a lightweight, extensible, globally installed AI coding assistant (Phase 1: Foundation Layer).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "coder": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "chat"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "react-devtools-core": "^4.28.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
